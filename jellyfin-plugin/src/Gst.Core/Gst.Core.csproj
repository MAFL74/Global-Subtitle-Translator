<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableGoogleProvider Condition="'$(EnableGoogleProvider)' == ''">true</EnableGoogleProvider>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableGoogleProvider)' == 'true'">
    <PackageReference Include="Google.Apis.Auth" Version="1.73.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableGoogleProvider)' != 'true'">
    <Compile Remove="GoogleNmtTranslationProvider.cs" />
  </ItemGroup>
</Project>
